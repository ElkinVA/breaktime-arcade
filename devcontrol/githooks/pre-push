#!/usr/bin/env python3
"""Pre-push guard for autonomous BA development.

Blocks commits that add secret-looking values or forbidden secret paths.
Install with `./devcontrol/install_service.sh` (writes .git/hooks/pre-push).
Never bypass with --no-verify for autonomous pushes.
"""

from __future__ import annotations

import re
import subprocess
import sys

FORBIDDEN_PATH = re.compile(r"(^|/)(\.env(\..*)?|certs|creds)(/|$)")
SECRET_PATTERNS = (
    re.compile(r"\bsk-[A-Za-z0-9_-]{20,}\b"),
    re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
    re.compile(r"\bgh[pousr]_[A-Za-z0-9]{20,}\b"),
    re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b"),
    re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----"),
    re.compile(r"\b\d{8,10}:[A-Za-z0-9_-]{30,}\b"),
    re.compile(
        r"(?i)\b[A-Z0-9_]*(?:PASSWORD|SECRET|API_KEY|AUTH_TOKEN)\s*=\s*"
        r"(?!changeme|example|placeholder|<|\$\{|your-|xxx)\S{6,}"
    ),
)
ALLOWED_EXAMPLES = (".example",)


def git(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["git", *args], capture_output=True, text=True, check=False)


def base_commit(local_sha: str, remote_sha: str) -> str:
    if set(remote_sha) <= {"0"}:
        merged = git("merge-base", local_sha, "origin/main").stdout.strip()
        if merged:
            return merged
        root = git("rev-list", "--max-parents=0", local_sha).stdout.strip().splitlines()
        return root[0] if root else local_sha
    return remote_sha


def main() -> int:
    for line in sys.stdin:
        parts = line.split()
        if len(parts) != 4:
            continue
        _local_ref, local_sha, _remote_ref, remote_sha = parts
        base = base_commit(local_sha, remote_sha)
        files = git("diff", "--name-only", f"{base}..{local_sha}").stdout.splitlines()
        forbidden = [
            path
            for path in files
            if FORBIDDEN_PATH.search(path) and not path.endswith(ALLOWED_EXAMPLES)
        ]
        if forbidden:
            print(f"pre-push: forbidden secret path(s): {', '.join(forbidden)}", file=sys.stderr)
            return 1
        for path in files:
            if path.endswith(ALLOWED_EXAMPLES):
                continue
            diff = git("diff", "--unified=0", base, local_sha, "--", path).stdout
            added = "\n".join(
                text[1:]
                for text in diff.splitlines()
                if text.startswith("+") and not text.startswith("+++")
            )
            for pattern in SECRET_PATTERNS:
                match = pattern.search(added)
                if match:
                    print(
                        f"pre-push: secret-like value in {path} "
                        f"(pattern {pattern.pattern[:40]}); push blocked",
                        file=sys.stderr,
                    )
                    return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
