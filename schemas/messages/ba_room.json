{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breaktime-arcade.local/schemas/messages/ba_room.json",
  "title": "ba:room",
  "description": "Live Room command through the host bridge (additive SDK 1.2).",
  "allOf": [
    {
      "$ref": "_envelope.json"
    },
    {
      "properties": {
        "type": {
          "const": "ba:room"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "create",
                "join",
                "state",
                "command",
                "leave"
              ]
            },
            "roomId": {
              "type": "string",
              "format": "uuid"
            },
            "code": {
              "type": "string",
              "minLength": 4,
              "maxLength": 8
            },
            "name": {
              "type": "string",
              "maxLength": 24
            },
            "gameId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "maxPlayers": {
              "type": "integer",
              "minimum": 4,
              "maximum": 12
            },
            "undercoverCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "mrWhite": {
              "type": "boolean"
            },
            "categoryId": {
              "type": "string",
              "maxLength": 32
            },
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "commandPayload": {
              "type": "object"
            },
            "expectedVersion": {
              "type": "integer",
              "minimum": 0
            },
            "requestId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "op"
          ]
        },
        "source": {
          "const": "ba-sdk"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    }
  ]
}
