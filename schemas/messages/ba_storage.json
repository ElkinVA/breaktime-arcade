{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breaktime-arcade.local/schemas/messages/ba_storage.json",
  "title": "ba:storage",
  "description": "Операция хранилища.",
  "allOf": [
    {
      "$ref": "_envelope.json"
    },
    {
      "properties": {
        "type": {
          "const": "ba:storage"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "get",
                "set",
                "remove"
              ]
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "value": {}
          },
          "required": [
            "op",
            "key"
          ]
        },
        "source": {
          "const": "ba-sdk"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    }
  ]
}
