{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breaktime-arcade.local/schemas/messages/ba_leaderboard_data.json",
  "title": "ba:leaderboard:data",
  "description": "Данные таблицы рекордов.",
  "allOf": [
    {
      "$ref": "_envelope.json"
    },
    {
      "properties": {
        "type": {
          "const": "ba:leaderboard:data"
        },
        "payload": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "rank",
                  "nickname",
                  "value"
                ],
                "properties": {
                  "rank": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "nickname": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "value": {
                    "type": "number"
                  }
                }
              }
            },
            "myRank": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "entries",
            "myRank"
          ]
        },
        "source": {
          "const": "ba-host"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    }
  ]
}
