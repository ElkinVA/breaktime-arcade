# BA autonomy orchestrator — NON-SECRET environment template.
#
# This file contains tuning values only. It never contains tokens, API keys or
# passwords. Copy it to ~/.config/ba/orchestrator.env (mode 0600) and adjust.
# systemd loads it via EnvironmentFile=-%h/.config/ba/orchestrator.env.
#
# Secret locations (never copy their contents into this file or the unit):
#   Model credentials: ~/.config/ba/deepseek.env (0600)
#     ANTHROPIC_BASE_URL, ANTHROPIC_AUTH_TOKEN, ANTHROPIC_* model overrides
#   Telegram token: <repo>/creds/telegram.env (0600)
#     TELEGRAM_BOT_TOKEN, TELEGRAM_OWNER_ID / TELEGRAM_CHAT_ID

# --- Model routing (non-secret selectors) ---
BA_ARCHITECT_MODEL=deepseek-v4-pro
BA_DEVELOPER_MODEL=deepseek-flash[1m]
BA_QA_MODEL=deepseek-flash
BA_REVIEWER_MODEL=deepseek-v4-pro
BA_MODEL_TIMEOUT=900

# --- Hard per-run budgets ---
BA_MAX_TASKS_PER_RUN=1
BA_MAX_RUN_SECONDS=3600
BA_MAX_TOKENS=5000000
BA_MAX_COST_USD=5.0

# --- Optional owner notification (non-secret chat id only) ---
# The bot token stays in creds/telegram.env (0600).
# TELEGRAM_CHAT_ID=<owner-chat-id>

# --- Optional HTTP(S) proxy (no embedded credentials) ---
# TELEGRAM_PROXY=http://proxy.example.invalid:8080
