[Unit]
Description=BA autonomy heartbeat timer (existing orchestrator)
Documentation=file:%h/projects/ba/autonomy/vps/README.md
ConditionPathExists=%h/projects/ba/autonomy/orchestrator.py

[Timer]
OnBootSec=5min
OnUnitActiveSec=30min
AccuracySec=1min
Persistent=true
Unit=ba-autonomy-orchestrator.service

[Install]
WantedBy=timers.target
