# BA-PLAT-4.2, Приложение A. Значения не хранятся в Git.
# Локальное окружение создаётся командой: make env

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=
DJANGO_ALLOWED_HOSTS=
DEBUG=
ADMIN_URL_PREFIX=
PORTAL_ORIGIN=
GAMES_DOMAIN=
BA_GAMES_FRAME_SRC=

# --- Данные ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=
DB_POOL_ENABLED=
DB_POOL_MIN=
DB_POOL_MAX=
REDIS_CACHE_URL=
REDIS_BROKER_URL=
CELERY_BROKER_URL=

# --- Почта ---
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=

# --- Хранилище и CDN ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_PACKAGES_BUCKET=
S3_RUNTIME_BUCKET=
CDN_BASE_URL=

# --- Наблюдаемость и внешние сервисы ---
SENTRY_DSN=
SENTRY_ENV=
HIBP_ENABLED=

# --- Секреты прикладного уровня ---
ANON_SIGNING_KEY=
NICKNAME_HMAC_KEY=
SESSION_BINDING_KEY=
TOTP_ISSUER=

# --- Бэкапы ---
BACKUP_TARGET_URI=
BACKUP_PASSPHRASE=

# --- Веб-сервер и пайплайн ---
GUNICORN_WORKERS=
BA_SDK_DEFAULT_VERSION=
ZIP_MAX_BYTES=
CRITICAL_PATH_WARN_BYTES=
CRITICAL_PATH_MAX_BYTES=

# --- Сборка образов (фиксируется на этапе 0) ---
IMAGE_TAG=
PYTHON_IMAGE=
NODE_IMAGE=
UV_VERSION=

# --- Резервное копирование (§2.5) ---
BACKUP_DIR=/app/var/backups
BACKUP_RETENTION_DAYS=30
BA_BACKUP_CHECK_ENABLED=True
BA_BACKUP_STALE_HOURS=48
